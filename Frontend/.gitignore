# Frontend .gitignore
# Dependencies
node_modules/
# Build output
.next/
out/
# Environment files
*.env
*.env.*
# Uploads (runtime media)
uploads/
# Logs
npm-debug.log*
 yarn-debug.log*
 yarn-error.log*
# OS generated files
.DS_Store
Thumbs.db
# IDE / editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
